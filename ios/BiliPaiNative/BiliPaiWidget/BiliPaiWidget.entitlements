<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		The widget extension needs the same App Group as the
		host app so it can read the recent-videos / watch-later
		UserDefaults that BiliPaiAppIntents writes from the
		main process. Without this entitlement the extension
		would fall back to a private UserDefaults suite and
		never see the user's library.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.darrenintr.bilipai</string>
	</array>
</dict>
</plist>
