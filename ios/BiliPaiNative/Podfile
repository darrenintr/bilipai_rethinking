platform :ios, '15.0'
use_frameworks!

target 'BiliPaiNative' do
  # AliyunPlayer removed in favour of AVPlayer + the DASH→HLS
  # bridge in BiliResourceLoaderDelegate.swift.  No third-party
  # player SDK is needed for the iOS native target.
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
