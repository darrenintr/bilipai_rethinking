platform :ios, '15.0'
use_frameworks!

target 'BiliPaiNative' do
  pod 'AliPlayerSDK_iOS', '~> 5.5'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # ------------------------------------------------------------------
  # Remove [CP] Embed Pods Frameworks from the BiliPaiNative target.
  # This phase runs inside an Xcode-managed sandbox that denies
  # file-write-create (blocked for both rsync --delete mkstemp and
  # cp).  The frameworks are instead copied by the CI workflow step
  # (plain cp -R) which runs OUTSIDE any sandbox.
  #
  # Implementation notes (CocoaPods 1.16.2):
  # * The public API is `aggregate_target.user_target_uuids`
  #   (an Array<String>) and `aggregate_target.user_project`
  #   (an Xcodeproj::Project).
  # * The convenience reader `user_targets` resolves each uuid via
  #   `user_project.objects_by_uuid[uuid]` and *raises* Informative
  #   if any uuid is missing — which is exactly the
  #   "attempted to initialize an object with an unknown UUID"
  #   condition that the install sometimes hits when integrating
  #   the AliPlayerSDK pod.  We therefore look up each uuid by hand
  #   and skip the missing ones, so a partial user_project never
  #   aborts `pod install`.
  # ------------------------------------------------------------------
  installer.aggregate_targets.each do |aggregate_target|
    next unless aggregate_target.user_project

    aggregate_target.user_target_uuids.each do |uuid|
      user_target = aggregate_target.user_project.objects_by_uuid[uuid]
      next unless user_target
      next unless user_target.respond_to?(:name) && user_target.name == 'BiliPaiNative'

      embed_phase = user_target.build_phases.find do |bp|
        bp.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase) &&
          bp.name.to_s.include?('Embed Pods Frameworks')
      end
      if embed_phase
        user_target.build_phases.delete(embed_phase)
        Pod::UI.puts "[BiliPai patch] Removed [CP] Embed Pods Frameworks from #{user_target.name}"
      end
    end
  end
end
