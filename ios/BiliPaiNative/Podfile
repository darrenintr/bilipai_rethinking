platform :ios, '15.0'
use_frameworks!

target 'BiliPaiNative' do
  pod 'AliPlayerSDK_iOS', '~> 5.5'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # ------------------------------------------------------------------
  # Remove [CP] Embed Pods Frameworks from the BiliPaiNative target.
  # This phase runs inside an Xcode-managed sandbox that denies
  # file-write-create (blocked for both rsync --delete mkstemp and
  # cp).  The frameworks are instead copied by the CI workflow step
  # (plain cp -R) which runs OUTSIDE any sandbox.
  #
  # Implementation notes (CocoaPods 1.16.2):
  # * The post_install hook fires BEFORE the user xcodeproj has been
  #   saved to disk, but AFTER the in-memory object graph has been
  #   built.  We must therefore mutate the in-memory
  #   `aggregate_target.user_project` so that the subsequent
  #   integrate_user_project -> save flow serialises the project
  #   without the offending phase.  Reading the project from disk with
  #   Xcodeproj::Project.open would see the pre-install state and miss
  #   the phase entirely.
  # * `aggregate_target.user_targets` is a convenience method that
  #   *raises* `Informative` if any uuid is missing from
  #   `user_project.objects_by_uuid` — which is exactly what happens
  #   when the AliPlayerSDK pod triggers the
  #   "attempted to initialize an object with an unknown UUID ...
  #    for attribute: build_phases" warning.  We look up each uuid by
  #   hand and skip the missing ones.
  # ------------------------------------------------------------------
  installer.aggregate_targets.each do |aggregate_target|
    user_project = aggregate_target.user_project
    next unless user_project

    aggregate_target.user_target_uuids.each do |uuid|
      user_target = user_project.objects_by_uuid[uuid]
      next unless user_target
      next unless user_target.respond_to?(:name) && user_target.name == 'BiliPaiNative'

      removed = 0
      user_target.build_phases.dup.each do |bp|
        # Match shell-script build phases that look like the CocoaPods
        # embed-frameworks script.  We avoid `is_a?` class checks because
        # Xcodeproj's PBXShellScriptBuildPhase may load under slightly
        # different namespaces across versions; the two content checks
        # below are stable identifiers of the offending phase.
        next unless bp.respond_to?(:shell_script) || bp.respond_to?(:name)
        name_hit   = bp.respond_to?(:name) && bp.name.to_s.include?('Embed Pods Frameworks')
        script_hit = bp.respond_to?(:shell_script) && bp.shell_script.to_s.include?('-frameworks.sh')
        next unless name_hit || script_hit

        user_target.build_phases.delete(bp)
        removed += 1
      end
      Pod::UI.puts "[BiliPai patch] Removed #{removed} embed-frameworks phase(s) from #{user_target.name}" if removed > 0
    end
  end
end
