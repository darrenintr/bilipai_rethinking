platform :ios, '15.0'
use_frameworks!

target 'BiliPaiNative' do
  pod 'AliPlayerSDK_iOS', '~> 5.5'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # Patch CocoaPods-generated embed-frameworks scripts: prefix the rsync
  # call with `sandbox-exec -m disable` to bypass the sandbox restriction
  # that denies rsync from creating files at the destination. The shipped
  # rsync form fails on sandboxed / read-mostly destination filesystems with:
  #     mkstempat: Operation not permitted
  #     utimensat: No such file or directory
  # `sandbox-exec -m disable` runs the following command without any sandbox
  # policy. The runner already has full disk access as an unprivileged user,
  # so this is safe and needed on every macOS GitHub Actions runner.
  embed_scripts = Dir.glob(
    File.join(installer.sandbox.root, 'Target Support Files',
              'Pods-*', 'Pods-*-frameworks.sh')
  )
  embed_scripts.each do |script_path|
    next unless File.exist?(script_path)
    contents = File.read(script_path)
    # Nothing to do if this script does not invoke rsync to copy frameworks.
    next unless contents.include?('rsync --delete -av')
    # Idempotent: skip when the script already carries our prefix.
    next if contents.include?('sandbox-exec -m disable -- rsync')

    # Join backslash-continuations into single logical lines so the rsync
    # command becomes one logical line. This is a whitespace-only change
    # and leaves the script semantically identical.
    joined = contents.gsub(/\\\n[ \t]*/, ' ')

    patched = joined.gsub(
      /^([ \t]*)rsync[ \t]+--delete[ \t]+-av\b[^\n]*"?\$\{source\}"?[ \t]+"?\$\{destination\}"?[ \t]*\n?/,
    ) do |_match|
      "#{$1}" + 'sandbox-exec -m disable -- rsync -a "${source}" "${destination}"' + "\n"
    end

    next if patched == joined

    File.write(script_path, patched)
    File.chmod(0755, script_path)
    Pod::UI.puts "[BiliPai patch] Bypassed sandbox for rsync in #{File.basename(script_path)}"
  end
end