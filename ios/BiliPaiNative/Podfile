platform :ios, '15.0'
use_frameworks!

target 'BiliPaiNative' do
  pod 'AliPlayerSDK_iOS', '~> 5.5'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # ------------------------------------------------------------------
  # Remove [CP] Embed Pods Frameworks from the BiliPaiNative target.
  # This phase runs inside an Xcode-managed sandbox that denies
  # file-write-create (blocked for both rsync --delete mkstemp and
  # cp).  The frameworks are instead copied by the CI workflow step
  # (plain cp -R) which runs OUTSIDE any sandbox.
  #
  # NOTE: CocoaPods 1.16.2 occasionally emits
  #   "attempted to initialize an object with an unknown UUID ...
  #    for attribute: build_phases"
  # which leaves the surrounding AggregateTarget partially constructed,
  # so attribute readers (target / native_target / user_target) can
  # raise NoMethodError depending on the version.  Wrap the whole block
  # in begin/rescue so a single bad hook cannot abort `pod install`.
  # If the embed-phase removal fails here, the CI workflow's
  # "Manually embed AliPlayerSDK frameworks" step still copies the
  # frameworks into <App>.app/Frameworks/, so the IPA is unaffected.
  # ------------------------------------------------------------------
  begin
    installer.aggregate_targets.each do |aggregate_target|
      target = aggregate_target.respond_to?(:target) ? aggregate_target.target : nil
      next unless target

      embed_phase = target.build_phases.find do |bp|
        bp.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase) &&
          bp.name.to_s.include?('Embed Pods Frameworks')
      end
      if embed_phase
        target.build_phases.delete(embed_phase)
        Pod::UI.puts "[BiliPai patch] Removed [CP] Embed Pods Frameworks from #{target.name}"
      end
    end
  rescue => e
    Pod::UI.warn "[BiliPai patch] Embed-phase removal skipped: #{e.class}: #{e.message}"
  end
end
