platform :ios, '15.0'
use_frameworks!

target 'BiliPaiNative' do
  pod 'AliPlayerSDK_iOS', '~> 5.5'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # ------------------------------------------------------------------
  # Remove [CP] Embed Pods Frameworks from the BiliPaiNative target.
  # This phase runs inside an Xcode-managed sandbox that denies
  # file-write-create (blocked for both rsync --delete mkstemp and
  # cp).  The frameworks are instead copied by the CI workflow step
  # (plain cp -R) which runs OUTSIDE any sandbox.
  #
  # We bypass the CocoaPods AggregateTarget API entirely because
  # integrating the AliPlayerSDK pod triggers an
  #   "attempted to initialize an object with an unknown UUID ...
  #    for attribute: build_phases"
  # warning that leaves the AggregateTarget's user_project half-loaded.
  # Going through `Xcodeproj::Project.open` on the .xcodeproj file on
  # disk gives us an unmodified, fully-resolved view of the project.
  #
  # We do NOT match on class identity (`is_a?`) because in some
  # Xcodeproj versions the class is loaded under slightly different
  # namespaces.  Instead we match on `shell_script` content — a
  # #${PODS_ROOT}/Target Support Files/...-frameworks.sh invocation
  # is the only place CocoaPods writes that exact path.  Belt and
  # braces: also remove by name substring.
  # ------------------------------------------------------------------
  require 'xcodeproj'

  podfile_dir = installer.sandbox.root.dirname
  Dir.glob(File.join(podfile_dir, '*.xcodeproj')).each do |project_path|
    next unless File.directory?(project_path)

    project = Xcodeproj::Project.open(project_path)
    project.targets.each do |user_target|
      next unless user_target.name == 'BiliPaiNative'

      embed_phases = user_target.build_phases.select do |bp|
        # Match shell-script build phases that look like the CocoaPods
        # embed-frameworks script.  Two heuristics:
        #  1. name contains "Embed Pods Frameworks"
        #  2. shell_script references "Target Support Files" + "frameworks"
        next false unless bp.respond_to?(:shell_script) || bp.respond_to?(:name)
        name_hit    = bp.respond_to?(:name) && bp.name.to_s.include?('Embed Pods Frameworks')
        script_hit  = bp.respond_to?(:shell_script) && bp.shell_script.to_s.include?('-frameworks.sh')
        name_hit || script_hit
      end
      embed_phases.each do |phase|
        user_target.build_phases.delete(phase)
        Pod::UI.puts "[BiliPai patch] Removed embed-frameworks phase from #{user_target.name} (in #{File.basename(project_path)})"
      end
    end
    project.save
  end
end
