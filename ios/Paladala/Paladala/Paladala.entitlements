<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		App Group: shared container so the widget extension can
		read the user's most-recently-watched videos that the
		main app writes. Both the Paladala app and the
		PaladalaWidget extension must declare the same group
		identifier; the CI build (CODE_SIGNING_ALLOWED=NO) does
		not enforce the entitlement, but a real device build
		requires the user to register this group on their
		Apple Developer account before the widget can read it.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.darrenintr.paladala</string>
	</array>
	<!--
		iCloud key-value store. We only need the lightweight
		NSUbiquitousKeyValueStore surface for now (no
		CloudKit, no Documents container) so the entitlements
		footprint stays minimal. The container identifier is
		a placeholder that the user will need to register with
		their team; without it the entitlement is ignored at
		runtime, which is the correct graceful-degradation
		behaviour for the iCloud toggle in ProfileSettings.
	-->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
