{
  "name": "paladala-portal-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init:local": "wrangler d1 execute paladala-portal --local --file=./migrations/0001_init.sql",
    "d1:init:remote": "wrangler d1 execute paladala-portal --remote --file=./migrations/0001_init.sql",
    "d1:console:local": "wrangler d1 execute paladala-portal --local --command=\"SELECT * FROM reports ORDER BY id DESC LIMIT 5\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  },
  "dependencies": {
    "itty-router": "^5.0.18",
    "zod": "^3.23.8"
  }
}
